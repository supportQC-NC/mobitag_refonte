:8080 {
	root * /srv
	file_server
	encode gzip zstd

	header {
		# Rien n'est chargé depuis l'extérieur : la page est autonome.
		# 'unsafe-inline' reste nécessaire tant que le CSS et le JS sont
		# dans le document ; à extraire en fichiers lors de l'industrialisation.
		Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"

		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()"

		# Le contenu d'un message ne doit jamais être mis en cache par un
		# intermédiaire : la page est servie telle quelle, sans stockage.
		Cache-Control "no-store"

		-Server
	}

	log {
		# Aucune donnée personnelle dans les journaux : ni numéro, ni contenu.
		format console
		level WARN
	}
}
