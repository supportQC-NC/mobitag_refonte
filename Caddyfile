:8080 {
	root * /srv
	file_server
	encode gzip zstd

	header {
		# Le CSS et le JS étant dans des fichiers servis depuis la même origine,
		# la politique n'a plus besoin de 'unsafe-inline' : aucun script ni style
		# inline ne peut plus s'exécuter, y compris injecté.
		Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"

		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"

		-Server
	}

	# Le document porte le contenu d'un message : jamais de cache intermédiaire.
	@document path / /index.html
	header @document Cache-Control "no-store"

	# Les ressources statiques sont figées et peuvent être mises en cache.
	# À l'industrialisation, ajouter une empreinte au nom de fichier
	# (styles.a1b2c3.css) pour pouvoir passer en immutable sans risque.
	@statique path *.css *.js
	header @statique Cache-Control "public, max-age=3600"

	log {
		# Aucune donnée personnelle dans les journaux : ni numéro, ni contenu
		# de message. Seuls les incidents sont tracés.
		format console
		level WARN
	}
}
